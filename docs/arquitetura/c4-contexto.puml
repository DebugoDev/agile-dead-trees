@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title Nível 1 — Contexto do sistema Agile Dead Trees

Person(autor, "Autor / Equipe Editorial", "Redige, revisa e aprova manuscritos")
Person(leitor, "Leitor / Cliente", "Busca obras, compra e recebe recomendações")
Person(operador, "Operador Gráfico", "Acompanha e executa ordens de impressão")

System(adt, "Plataforma Agile Dead Trees", "Publicação híbrida: e-books e impressão física")

System_Ext(graficas, "Gráficas legadas", "CLP / mainframe — OPC UA, serial e XML/EDI")
System_Ext(pagamento, "Gateway de pagamento", "Autorização de cobranças via HTTPS/REST")
System_Ext(llm, "Provedores LLM", "Inferência externa via AI Gateway")
System_Ext(planilhas, "Planilhas eletrônicas", "CSV, XLSX e ODS")

Rel(autor, adt, "Envia manuscritos e metadados", "HTTPS")
Rel(leitor, adt, "Busca e compra", "HTTPS")
Rel(operador, adt, "Recebe ordens de impressão", "OPC UA / serial")
Rel(adt, graficas, "Envia ordens e recebe status", "XML/EDI, OPC UA")
Rel(adt, pagamento, "Autoriza pagamentos", "HTTPS/REST")
Rel(adt, llm, "Invoca inferência", "HTTPS/mTLS")
Rel(planilhas, adt, "Importa dados validados", "Kafka")

@enduml
