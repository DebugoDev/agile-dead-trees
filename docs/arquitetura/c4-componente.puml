@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title Nível 3 — Componentes do Core & Integração (ACL)

Container(core, "Core & Orquestrador Gráfico", "C# / .NET LTS")
Container(adapters, "LegacyIntegration", "C# / .NET LTS")
Container(kafka, "Barramento de eventos", "Apache Kafka")

Container_Boundary(acl, "Camada Anti-Corrupção") {
  Component(service, "IntegrationService", "C#", "Orquestra envio de ordens de impressão")
  Component(factory, "PrinterAdapterFactory", "C#", "Factory Method — cria adaptadores conforme a gráfica")
  Component(client, "IPrinterClient", "C# (interface)", "Contrato estável — DIP")
  Component(serial, "SerialMainframeAdapter", "C#", "Adapter para comunicação serial")
  Component(opcua, "OpcUaMainframeAdapter", "C#", "Adapter para OPC UA")
  Component(translated, "LegacyTranslator", "C#", "Traduz DTOs do domínio para XML/EDI")
  Component(strategy, "ISpreadsheetValidationStrategy", "C# (interface)", "Strategy — validação de planilhas")
  Component(csv, "AuthorCsvStrategy", "C#", "Estratégia para CSV de autores")
  Component(xlsx, "StockExcelStrategy", "C#", "Estratégia para XLSX de estoque")
}

Component(resilience, "Polly Policies", "C#", "Timeout 2s, Retry com backoff e Circuit Breaker")
Component(router, "Content-Based Router", "C#", "EIP — roteia eventos por tipo de conteúdo")
Component(dlq, "Dead Letter Queue", "Kafka", "Fallback e auditoria de ordens falhas")

Rel(service, factory, "Solicita adaptador", "IPrinterClient")
Rel(factory, client, "Retorna implementação")
Rel(client, serial, "implementa")
Rel(client, opcua, "implementa")
Rel(service, translated, "Converte payloads")
Rel(translated, kafka, "Publica eventos")
Rel(service, strategy, "Injeta estratégia")
Rel(strategy, csv, "implementa")
Rel(strategy, xlsx, "implementa")
Rel(service, resilience, "Aplica proteção")
Rel(resilience, dlq, "Fallback em falha")
Rel(kafka, router, "Consome eventos")

@enduml
